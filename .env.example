# k-skill 프록시 (잇플 등). 키 없이 사용, 서버에서만 호출
KSKILL_PROXY_BASE_URL=https://k-skill-proxy.nomadamas.org

# 네이버 지도 (네이버 클라우드 콘솔 > Maps > Application 등록)
# - 지도 표시(Dynamic Map)용 키 ID. 브라우저에 공개되는 값이라 NEXT_PUBLIC_
#   콘솔의 Web 서비스 URL에 http://localhost:3000 과 실제 도메인을 꼭 등록
NEXT_PUBLIC_NAVER_MAP_KEY_ID=
# - 주소 → 좌표(Geocoding)용. 서버에서만 사용
NAVER_MAP_KEY_ID=
NAVER_MAP_KEY=

# 네이버 검색 API · 지역 검색 → 비워 두기
# 2026-07-30부터 개발자센터 신규 신청 중단(NCP NAVER API HUB로 이관), 9/7 개정 약관상
# AI 입력·수익화·가공 노출 금지라 이 서비스 용도에 맞지 않음. 비워 두면 카카오(k-skill)로 장소를 찾음
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 카카오톡 공유 버튼 전용 (지도는 네이버). JavaScript 키는 공개돼도 되는 키
NEXT_PUBLIC_KAKAO_JS_KEY=

# Supabase (모임 저장) · 서버 전용, NEXT_PUBLIC_ 붙이지 않기 (DB 비밀번호 포함)
# Supabase 대시보드 → 상단 Connect → Transaction pooler 주소 (포트 6543)
# 비우면 모임은 화면 데모로만 동작
SUPABASE_DB_URL=

# LLM (추천 이유 생성)
ANTHROPIC_API_KEY=
LLM_MODEL=

# GA4
NEXT_PUBLIC_GA_ID=

# 서비스 도메인 (공모전에 등록한 도메인과 동일하게)
NEXT_PUBLIC_SITE_URL=https://
